[
  {
    "name": "normalizeAccount (single pure helper)",
    "path": "dist/index.js",
    "import": "{ normalizeAccount }",
    "limit": "500 B"
  },
  {
    "name": "formatAccount + patternTemplate",
    "path": "dist/index.js",
    "import": "{ formatAccount, patternTemplate }",
    "limit": "700 B"
  },
  {
    "name": "one institution only ({ kb })",
    "path": "dist/index.js",
    "import": "{ kb }",
    "limit": "1 KB"
  },
  {
    "name": "scoped detector ({ createDetector, kb, shinhan, toss })",
