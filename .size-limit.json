[
  {
    "name": "normalizeAccount (single pure helper)",
    "path": "dist/index.js",
    "import": "{ normalizeAccount }",
    "limit": "500 B"
  },
  {
    "name": "formatAccount + patternTemplate",
    "path": "dist/index.js",
    "import": "{ formatAccount, patternTemplate }",
    "limit": "700 B"
  },
  {
    "name": "one institution only ({ kb })",
    "path": "dist/index.js",
    "import": "{ kb }",
    "limit": "1 KB"
  },
  {
    "name": "scoped detector ({ createDetector, kb, shinhan, toss })",
    "path": "dist/index.js",
    "import": "{ createDetector, kb, shinhan, toss }",
    "limit": "4.5 KB"
  },
  {
    "name": "korean-account/zod (without the registry)",
    "path": "dist/adapters/zod/index.js",
    "import": "*",
    "ignore": ["zod"],
    "limit": "1500 B"
  },
  {
    "name": "detect (full registry — control)",
    "path": "dist/index.js",
    "import": "{ detect }",
    "limit": "13 kB"
  }
]
