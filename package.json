{
  "name": "korean-account",
  "version": "0.1.3",
  "description": "Korean bank account detector · 한국 계좌번호 식별·과목 추출 — KFTC CMS PDF 충실, TypeScript.",
  "keywords": [
    "account",
    "bank",
    "cms",
    "detection",
    "fintech",
    "kftc",
    "korean",
    "validation",
    "계좌",
    "계좌번호",
    "금융결제원",
    "은행",
    "한국"
  ],
  "homepage": "https://github.com/dydals3440/korean-account#readme",
  "bugs": {
    "url": "https://github.com/dydals3440/korean-account/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Matthew Kim",
    "email": "matthew@redband.co.kr"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dydals3440/korean-account.git"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "DOCS.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "zod": [
        "./dist/zod.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": {
        "import": "./dist/zod.d.ts",
        "require": "./dist/zod.d.cts"
      },
      "import": "./dist/adapters/zod/index.js",
      "require": "./dist/adapters/zod/index.cjs",
      "default": "./dist/adapters/zod/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown && node scripts/collect-dts.mjs && attw --pack . --profile strict && publint",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "format": "oxfmt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:bench": "vitest bench --run",
    "publint": "publint",
    "check:dist": "pnpm size && pnpm check:runtime",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm build && pnpm check:dist",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "size": "size-limit",
    "check:runtime": "node scripts/check-runtime.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "publint": "^0.3.23",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
